    "\r\n[HanaLima] 接続できませんでした。3 秒後に再試行します（%lld/%lld）…\r\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\r\n[HanaLima] Couldn't connect. Retrying in 3 seconds (%lld/%lld)…\r\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "\r\n[HanaLima] 接続できませんでした。3 秒後に再試行します（%1$lld/%2$lld）…\r\n"
          }
        }
      }
    },
    " ＋ ": {
      "comment": "Between sizes, as in 1.2 GB + external 300 MB",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " + "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " ＋ "
          }
        }
      }
    },
    "# /bin/sh で実行されます（#! は不要）\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Runs with /bin/sh (no #! needed)\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# /bin/sh で実行されます（#! は不要）\n"
          }
        }
      }
    },
    "%@ · ダウンロード %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Downloading %2$lld%%"
