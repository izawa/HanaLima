          }
        }
      }
    },
    "スナップショットがあるあいだは移動できません（スナップショットはディスクと同じドライブに置くため）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t be moved while it has snapshots (they are kept on the same drive as the disk)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットがあるあいだは移動できません（スナップショットはディスクと同じドライブに置くため）。"
          }
        }
      }
    },
    "スナップショットの作成・復元・削除は、仮想マシンを停止してから行えます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the VM to create, restore or delete snapshots."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットの作成・復元・削除は、仮想マシンを停止してから行えます。"
          }
        }
      }
    },
    "スナップショットの復元": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Snapshot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットの復元"
          }
        }
      }
    },
    "スナップショットの復元中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring snapshot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットの復元中"
          }
        }
      }
    },
    "スナップショットは QEMU の仮想マシンでのみ使えます": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots Are Available for QEMU VMs Only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットは QEMU の仮想マシンでのみ使えます"
          }
        }
      }
    },
    "スナップショットは、ディスクと共有している部分も数えています。実際に使っているのは、その後にディスクが変わった分だけです。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots are counted in full, including what they still share with the disk. They actually take only what has changed on the disk since."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットは、ディスクと共有している部分も数えています。実際に使っているのは、その後にディスクが変わった分だけです。"
          }
        }
      }
    },
    "スナップショットはありません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Snapshots"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットはありません"
          }
        }
      }
    },
    "スナップショットはコピーに含まれません（コピー元に残ります）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots aren’t copied (they stay with the original)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットはコピーに含まれません（コピー元に残ります）。"
          }
        }
      }
    },
    "スナップショットはディスクと同じドライブにあります。ドライブを接続すると表示します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots are kept on the same drive as the disk. Connect the drive to see them."
          }
        },
        "ja": {
          "stringUnit": {
