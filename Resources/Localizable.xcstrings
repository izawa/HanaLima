            "value": "Couldn't turn on start at login for “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の自動起動を有効にできませんでした"
          }
        }
      }
    },
    "「%@」の自動起動を無効にできませんでした": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't turn off start at login for “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の自動起動を無効にできませんでした"
          }
        }
      }
    },
    "「%@」の起動ディスクの今の状態を保存します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the current state of the boot disk of “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の起動ディスクの今の状態を保存します。"
          }
        }
      }
    },
    "「%@」の起動ディスクの現在の状態を保存します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the current state of “%@”'s boot disk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の起動ディスクの現在の状態を保存します。"
          }
        }
      }
    },
    "「%@」は %@ です。APFS でないと、ディスクが名目のサイズ（%@）を丸ごと使ってしまいます。APFS でフォーマットしたドライブを選んでください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is %2$@. Off APFS, the disk would take its full size (%3$@). Choose a drive formatted as APFS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "「%1$@」は %2$@ です。APFS でないと、ディスクが名目のサイズ（%3$@）を丸ごと使ってしまいます。APFS でフォーマットしたドライブを選んでください。"
          }
        }
      }
    },
    "「%@」は「%@」とディスクを共有しています": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” Shares a Disk with “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "「%1$@」は「%2$@」とディスクを共有しています"
          }
        }
      }
    },
    "「%@」は既に存在します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” already exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は既に存在します。"
          }
        }
      }
    },
    "「%@」を削除しますか？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？"
          }
        }
      }
    },
    "「%@」を含む行はありません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No lines contain “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を含む行はありません。"
          }
        }
      }
    },
    "「%@」を複製": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を複製"
          }
        }
      }
    },
    "「%@」を複製し、ディスクをこのスナップショットの状態にします。「%@」自体は今の状態のままです。設定（CPU、メモリ、ネットワークなど）は今の「%@」のものです。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies “%1$@” and puts its disk in the state of this snapshot. “%2$@” itself stays as it is now. The settings (CPUs, memory, networks and so on) are those of “%3$@” now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "「%1$@」を複製し、ディスクをこのスナップショットの状態にします。「%2$@」自体は今の状態のままです。設定（CPU、メモリ、ネットワークなど）は今の「%3$@」のものです。"
          }
        }
      }
    },
    "「%@」自身の NIC で": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On “%@”'s own NICs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」自身の NIC で"
          }
        }
      }
    },
    "「%@」（%@）・空き %@。保存先: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (%2$@), %3$@ free. Saved in: %4$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "「%1$@」（%2$@）・空き %3$@。保存先: %4$@"
          }
        }
      }
    },
    "「ディスクを独立させる」は、同じドライブの上に APFS のクローン（書き込むまで中身を共有するコピー）を作るので、すぐに終わり、容量もほとんど使いません。「この Mac に戻す」でも、この仮想マシン専用のディスクになります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give Disk Its Own Copy makes an APFS clone on the same drive (a copy that shares its contents until either side writes), so it finishes at once and takes almost no space. Move Back to This Mac also gives this virtual machine a disk of its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ディスクを独立させる」は、同じドライブの上に APFS のクローン（書き込むまで中身を共有するコピー）を作るので、すぐに終わり、容量もほとんど使いません。「この Mac に戻す」でも、この仮想マシン専用のディスクになります。"
          }
        }
      }
    },
    "あとから「この Mac に戻す」で、いつでも内蔵ディスクに戻せます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can bring it back to the internal disk anytime with Move Back to This Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとから「この Mac に戻す」で、いつでも内蔵ディスクに戻せます。"
          }
        }
      }
    },
    "この Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac"
          }
        }
      }
    },
    "この Mac に戻す…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Back to This Mac…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac に戻す…"
          }
        }
      }
    },
    "この Mac（内蔵ディスク）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac (internal disk)"
          }
        },
        "ja": {
