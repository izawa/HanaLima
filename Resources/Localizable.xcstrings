    "\r\n[HanaLima] 接続できませんでした。3 秒後に再試行します（%lld/%lld）…\r\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\r\n[HanaLima] Couldn't connect. Retrying in 3 seconds (%lld/%lld)…\r\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "\r\n[HanaLima] 接続できませんでした。3 秒後に再試行します（%1$lld/%2$lld）…\r\n"
          }
        }
      }
    },
    "# /bin/sh で実行されます（#! は不要）\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Runs with /bin/sh (no #! needed)\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# /bin/sh で実行されます（#! は不要）\n"
          }
        }
      }
    },
    "%@ · ダウンロード %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Downloading %2$lld%%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · ダウンロード %2$lld%%"
          }
        }
      }
    },
    "%@ が root 所有になっていません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not owned by root"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が root 所有になっていません"
          }
        }
      }
    },
    "%@ が所属していません。networks.yaml の group を変更するか、ユーザーをグループに追加してください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a member. Change the group in networks.yaml, or add the user to the group"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が所属していません。networks.yaml の group を変更するか、ユーザーをグループに追加してください"
          }
        }
      }
    },
    "%@ と %@ を削除します。lima:shared / host / bridged を使う VM は起動できなくなります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes %@ and %@. VMs using lima:shared / host / bridged will no longer start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ と %2$@ を削除します。lima:shared / host / bridged を使う VM は起動できなくなります。"
          }
        }
      }
    },
    "%@ とアドレス範囲が重なっています。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address range overlaps with %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ とアドレス範囲が重なっています。"
          }
        }
      }
    },
    "%@ の LAN に接続・IP は LAN の DHCP から": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joins the LAN on %@ · IP from the LAN's DHCP"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の LAN に接続・IP は LAN の DHCP から"
          }
        }
      }
    },
    "%@ の%@に失敗しました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ failed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ の%2$@に失敗しました"
          }
        }
      }
    },
    "%@ は %@ の中で、ゲートウェイ以外のアドレスにしてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ must be inside %2$@ and not the gateway."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ は %2$@ の中で、ゲートウェイ以外のアドレスにしてください。"
          }
        }
      }
    },
    "%@ は所属しています": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a member"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は所属しています"
          }
        }
      }
    },
    "%@ は空です。ゲストによっては、このコンソールに何も出力しません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is empty. Some guests don't write anything to this console."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は空です。ゲストによっては、このコンソールに何も出力しません。"
          }
        }
      }
    },
    "%@/秒": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/s"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/秒"
          }
        }
      }
    },
    "%@、socket_vmnet のネットワーク（%@）と HanaLima の仮想ネットワーク（%@）が同時に使われます。HanaLima はこの組み合わせで動作を確認していますが、macOS の不具合（FB25122122）により、ほかの仮想化ツールが vmnet のネットワークを使い回すと、ブリッジの通信や Mac 本体の IPv4 接続が切れることがあります。その場合は VM を止めて、システム設定で DHCP リースを更新するか Mac を再起動してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, socket_vmnet networks (%2$@) and HanaLima virtual networks (%3$@) will be used at the same time. HanaLima has been tested with this combination, but because of a macOS bug (FB25122122), if another virtualization tool reuses a vmnet network, the bridge or your Mac's own IPv4 connection can drop. If that happens, stop the VMs and renew the DHCP lease in System Settings, or restart your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@、socket_vmnet のネットワーク（%2$@）と HanaLima の仮想ネットワーク（%3$@）が同時に使われます。HanaLima はこの組み合わせで動作を確認していますが、macOS の不具合（FB25122122）により、ほかの仮想化ツールが vmnet のネットワークを使い回すと、ブリッジの通信や Mac 本体の IPv4 接続が切れることがあります。その場合は VM を止めて、システム設定で DHCP リースを更新するか Mac を再起動してください。"
          }
        }
      }
    },
    "%@に失敗: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
