          }
        }
      }
    },
    "どの仮想マシンのものでもないデータ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data of No Virtual Machine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
