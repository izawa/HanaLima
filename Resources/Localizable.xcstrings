          }
        }
      }
    },
    "ディスクをリンクに置き換えられませんでした: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't replace the disk with a link: %@"
          }
        },
